# Goes into the scraper's User-Agent so terminals can reach a human.
CONTACT_EMAIL=you@example.com

# Optional. A healthchecks.io-style check URL. The hourly self-check pings it when healthy and
# <url>/fail when not, so you get an email if the archive breaks or stops. Set the check's
# period to 1 hour with a grace time of 30 minutes.
HEALTHCHECK_PING_URL=

# Optional. 1 switches on the synthetic (MOCK) appointments channel for UI work. Leave it off
# anywhere public.
TSA_ENABLE_MOCK=0
